// Title: Repeated low-volume outbound connections to non-private IPv4 destinations
// Description: Aggregates successful connections to non-private IPv4 destinations into fixed time buckets and surfaces destinations that recur across many buckets with low event volume.
// Suspicious Behavior: Repeated low-volume outbound connections to the same non-private destination across many time buckets.
// MITRE ATT&CK: T1071 Application Layer Protocol
// Pyramid of Pain: Network Artifacts / TTPs
// Kill Chain: Command and Control
// Relevant CTI: https://attack.mitre.org/techniques/T1071/
let Lookback = 14d;
let Bucket = 30m;
DeviceNetworkEvents
| where Timestamp >= ago(Lookback)
| where ActionType == "ConnectionSuccess"
| where isnotempty(RemoteIP)
| where ipv4_is_private(RemoteIP) == false
| summarize Events=count(), Buckets=dcount(bin(Timestamp, Bucket)), FirstSeen=min(Timestamp), LastSeen=max(Timestamp) by DeviceName, InitiatingProcessFileName, RemoteIP, RemotePort
| where Buckets >= 8 and Events <= Buckets * 4
| extend SpanHours=datetime_diff('hour', LastSeen, FirstSeen)
| where SpanHours >= 4
| order by Buckets desc, Events asc
